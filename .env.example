# ---------------------------------------------------------------------------
# Copiar para .env NA PASTA DO TEU PROJECTO e preencher. O .env nunca vai para
# o Git. Os scripts (skill ghl-scripts) lem-no da pasta onde correm.
# Diagnostico: node <pasta da skill ghl-scripts>/scripts/ghl-verificar.mjs
# ---------------------------------------------------------------------------

# A sub-conta (location) em que se trabalha. Esta no URL: .../location/<ID>/...
GHL_LOCATION_ID=

# API oficial (e servidor MCP oficial): Private Integration Token da sub-conta.
# Sub-conta > Settings > Private Integrations > Create new integration.
# Dar so os scopes necessarios. Tratar como uma password.
GHL_PIT_LOCATION=

# Onde a ESCRITA e permitida (ids separados por virgulas). Vazio = nenhuma
# escrita passa — e o comportamento certo por omissao. Mesmo com a location
# aqui, os scripts so escrevem com --executar.
GHL_WRITE_LOCATIONS=

# API interna (workflows, bots) — so se precisares dela. Capturados UMA vez,
# pela pessoa dona da conta, com sessao iniciada no GHL:
#   DevTools (F12) > Application > IndexedDB > firebaseLocalStorageDb
#     > firebaseLocalStorage > entrada "firebase:authUser:..."
#       value.stsTokenManager.refreshToken  -> GHL_REFRESH_TOKEN
#       value.apiKey                        -> GHL_FIREBASE_KEY
# O refresh token vale por uma sessao inteira: quem o tiver entra na conta.
GHL_REFRESH_TOKEN=
GHL_FIREBASE_KEY=

# Opcional: ritmo da API oficial (pedidos por 10 s; omissao 80, tecto do GHL 100).
# GHL_RATE_PER_10S=80
